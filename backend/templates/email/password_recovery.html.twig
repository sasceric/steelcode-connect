<!doctype html>
<html lang="{{ locale }}">
  <body style="margin: 0; padding: 0; background: #f4f7fb;">
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="background: #f4f7fb;">
      <tr>
        <td align="center" style="padding: 24px 12px;">
          <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="max-width: 600px; background: #ffffff; border-radius: 16px; overflow: hidden;">
            {% include 'email/_header.html.twig' %}
            <tr>
              <td style="padding: 0 40px 12px; color: #202b36; font-family: Arial, sans-serif;">
                <h1 style="margin: 0 0 16px; font-size: 28px; line-height: 34px;">{{ 'email.password_reset.title'|trans }}</h1>
                <p style="margin: 0 0 16px; font-size: 16px; line-height: 24px;">{{ 'email.password_reset.greeting'|trans({'%first_name%': first_name, '%last_name%': last_name}) }}</p>
                <p style="margin: 0 0 28px; color: #52606d; font-size: 16px; line-height: 24px;">{{ 'email.password_reset.introduction'|trans }}</p>
                <table role="presentation" cellspacing="0" cellpadding="0" border="0" style="margin: 0 0 28px;">
                  <tr>
                    <td style="border-radius: 8px; background: #066AE0;">
                      <a href="{{ reset_url }}" style="display: inline-block; padding: 13px 22px; color: #ffffff; font-family: Arial, sans-serif; font-size: 15px; font-weight: 700; text-decoration: none;">{{ 'email.password_reset.action'|trans }}</a>
                    </td>
                  </tr>
                </table>
                <p style="margin: 0 0 12px; color: #52606d; font-size: 14px; line-height: 21px;">{{ 'email.password_reset.expiry'|trans }}</p>
                <p style="margin: 0; color: #52606d; font-size: 14px; line-height: 21px;">{{ 'email.password_reset.ignore'|trans }}</p>
              </td>
            </tr>
            {% include 'email/_footer.html.twig' %}
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
