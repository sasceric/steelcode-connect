ALFQ,YAKE,mBAAA;AAAA,wBAJS,YAAAR,MAAA,aAAA,EAAc;AAAA,wBAAd,uBAAA,CAAA,CAAA,WAAAA,MAAA,aAAA,EAAc,OAAI,QAAA,CAAA,WAGNA,MAAA,mBAAA,EAAoB,MAAK,MAAA,CAAA;AAAA,wBAF7C,UAAUA,MAAA,gBAAA,GAAkB;AAAA,wBAC7B,OAAM;AAAA,sBAAA,GAAA,MAAA,GAAA,CAAA,cAAA,uBAAA,UAAA,CAAA;AAAA;;;kBAIVQ,YAKa,uBAAA;AAAA,oBAJV,OAAOR,MAAA,CAAA,EAAC,kBAAA;AAAA,oBACT,OAAM;AAAA,kBAAA,GAAA;AAAA,qCAEN,MAAgF;AAAA,sBAAhFQ,YAAgF,oBAAA;AAAA,wBAA9D,YAAAR,MAAA,aAAA,EAAc;AAAA,wBAAd,uBAAA,CAAA,WAAAA,MAAA,aAAA,EAAc,SAAM;AAAA,wBAAG,UAAUA,MAAA,gBAAA,GAAkB;AAAA,sBAAA,GAAA,MAAA,GAAA,CAAA,cAAA,uBAAA,UAAA,CAAA;AAAA;;;kBAEvEQ,YAQM,OAAA,EARD,OAAM,yBAAA,GAAwB;AAAA,oBACjCA,YAKER,MAAA,OAAA,GAAA;AAAA,sBAJC,OAAOA,MAAA,CAAA,EAAC,eAAA;AAAA,sBACT,OAAM;AAAA,sBACN,SAAQ;AAAA,sBACP,SAAA,CAAA,WAAO,cAAA,QAAa;AAAA,oBAAA,GAAA,MAAA,GAAA,CAAA,SAAA,SAAA,CAAA;AAAA,oBAEvBQ,YAAqER,MAAA,OAAA,GAAA;AAAA,sBAA3D,OAAOA,MAAA,CAAA,EAAC,aAAA;AAAA,sBAAiB,MAAK;AAAA,sBAAU,SAASA,MAAA,MAAA;AAAA,oBAAA,GAAA,MAAA,GAAA,CAAA,SAAA,SAAA,CAAA;AAAA;;;;;;;;;;;;;;;;;;;","names":["__nuxt_component_0","_withAsyncContext","__nuxt_component_1","__nuxt_component_2","_unref","_ssrInterpolate","_isRef","_withCtx","_push","_parent","_","_scopeId","_createVNode","_withModifiers"],"sources":["../../../../../../../app/pages/inventory/[section].vue"],"sourcesContent":["<script setup lang=\"ts\">\nimport type { TableColumn } from '@nuxt/ui'\n\ntype StockItem = {\n  productId: string\n  name: string\n  sku: string | null\n  stock: number\n  availableStock: number\n}\ntype Warehouse = {\n  id: string\n  code: string\n  name: string\n  active: boolean\n  default: boolean\n}\n\nconst route = useRoute()\nconst { t } = useI18n()\nconst notify = useAppToast()\nconst section = computed(() =>\n  ['suppliers', 'warehouses'].includes(String(route.params.section))\n    ? String(route.params.section)\n    : 'stock'\n)\nconst search = ref('')\nconst warehouseOpen = ref(false)\nconst saving = ref(false)\nconst editingWarehouse = ref<Warehouse | null>(null)\nconst warehouseForm = reactive({ name: '', code: '', active: true })\nconst warehouseValidation = useFormValidation()\nconst warehouseValidationErrors = warehouseValidation.errors\nconst UButton = resolveComponent('UButton')\nconst UBadge = resolveComponent('UBadge')\nconst UDropdownMenu = resolveComponent('UDropdownMenu')\n\nconst {\n  data: stockData,\n  status: stockStatus,\n  refresh: refreshStock\n} = await useAsyncData('inventory-stock', () =>\n  apiFetch<{ items: StockItem[] }>('/inventory/stock')\n)\nconst {\n  data: warehousesData,\n  status: warehousesStatus,\n  refresh: refreshWarehouses\n} = await useAsyncData('inventory-warehouses-page', () =>\n  apiFetch<{ warehouses: Warehouse[] }>('/inventory/warehouses')\n)\nconst stockItems = computed(() =>\n  (stockData.value?.items ?? []).filter(item =>\n    `${item.name} ${item.sku || ''}`.toLocaleLowerCase().includes(search.value.toLocaleLowerCase())\n  )\n)\nconst warehouses = computed(() =>\n  (warehousesData.value?.warehouses ?? []).filter(item =>\n    `${item.name} ${item.code}`.toLocaleLowerCase().includes(search.value.toLocaleLowerCase())\n  )\n)\nconst {\n  page: stockPage,\n  paginatedItems: paginatedStockItems,\n  pagination: stockPagination,\n  reset: resetStockPagination,\n  total: stockTotal\n} = useClientPagination(() => stockItems.value)\nconst {\n  page: warehousesPage,\n  paginatedItems: paginatedWarehouses,\n  pagination: warehousesPagination,\n  reset: resetWarehousesPagination,\n  total: warehousesTotal\n} = useClientPagination(() => warehouses.value)\n\nconst stockColumns: TableColumn<StockItem>[] = [\n  {\n    accessorKey: 'name',\n    header: () => t('products.name'),\n    cell: ({ row }) =>\n      h(\n        'button',\n        {\n          class: 'cursor-pointer font-medium text-highlighted hover:text-primary',\n          onClick: () => navigateTo(`/catalogue/products/${row.original.productId}`)\n        },\n        row.original.name\n      )\n  },\n  {\n    accessorKey: 'sku',\n    header: () => t('products.productNumber'),\n    cell: ({ row }) => row.original.sku || '—'\n  },\n  { accessorKey: 'stock', header: () => t('inventory.stock') },\n  {\n    accessorKey: 'availableStock',\n    header: () => t('inventory.availableStock')\n  }\n]\nconst warehouseActions = (warehouse: Warehouse) => [\n  [\n    {\n      label: t('common.edit'),\n      icon: 'i-lucide-pencil',\n      onSelect: () => openWarehouse(warehouse)\n    }\n  ]\n]\nconst warehouseColumns: TableColumn<Warehouse>[] = [\n  {\n    accessorKey: 'name',\n    header: () => t('inventory.warehouse'),\n    cell: ({ row }) => h('span', { class: 'font-medium text-highlighted' }, row.original.name)\n  },\n  { accessorKey: 'code', header: () => t('inventory.code') },\n  {\n    accessorKey: 'active',\n    header: () => t('inventory.status'),\n    cell: ({ row }) =>\n      h(\n        UBadge,\n        {\n          color: row.original.active ? 'success' : 'neutral',\n          variant: 'subtle'\n        },\n        () => (row.original.active ? t('inventory.active') : t('inventory.inactive'))\n      )\n  },\n  {\n    id: 'actions',\n    header: '',\n    cell: ({ row }) =>\n      h(\n        'div',\n        { class: 'flex justify-end' },\n        h(UDropdownMenu, { items: warehouseActions(row.original), content: { align: 'end' } }, () =>\n          h(UButton, {\n            'icon': 'i-lucide-ellipsis-vertical',\n            'color': 'neutral',\n            'variant': 'ghost',\n            'aria-label': t('common.edit')\n          })\n        )\n      )\n  }\n]\n\nconst openWarehouse = (warehouse?: Warehouse) => {\n  warehouseValidation.clear()\n  editingWarehouse.value = warehouse || null\n  Object.assign(\n    warehouseForm,\n    warehouse\n      ? { name: warehouse.name, code: warehouse.code, active: warehouse.active }\n      : { name: '', code: '', active: true }\n  )\n  warehouseOpen.value = true\n}\nconst saveWarehouse = async () => {\n  const fields = [\n    {\n      field: 'name',\n      value: warehouseForm.name,\n      label: t('inventory.warehouse'),\n      message: t('common.requiredField')\n    },\n    ...(editingWarehouse.value?.default\n      ? []\n      : [\n          {\n            field: 'code',\n            value: warehouseForm.code,\n            label: t('inventory.code'),\n            message: t('common.requiredField')\n          }\n        ])\n  ]\n  if (\n    !warehouseValidation.requireFields(\n      fields,\n      notify,\n      t('inventory.warehouseSaveFailed'),\n      labels => t('common.requiredFields', { fields: labels.join(', ') })\n    )\n  ) {\n    return\n  }\n\n  saving.value = true\n  try {\n    if (editingWarehouse.value)\n      await apiFetch(`/inventory/warehouses/${editingWarehouse.value.id}`, {\n        method: 'PATCH',\n        body: warehouseForm\n      })\n    else\n      await apiFetch('/inventory/warehouses', {\n        method: 'POST',\n        body: warehouseForm\n      })\n    await refreshWarehouses()\n    warehouseOpen.value = false\n    notify.success(t('inventory.warehouseSaved'), t('common.changesSaved'))\n  } catch (error: any) {\n    warehouseValidation.notifyApiError(\n      error,\n      notify,\n      t('inventory.warehouseSaveFailed'),\n      t('common.tryAgain')\n    )\n  } finally {\n    saving.value = false\n  }\n}\nwatch([section, search], () => {\n  resetStockPagination()\n  resetWarehousesPagination()\n})\n\nwatch(section, () => {\n  search.value = ''\n})\n</script>\n\n<template>\n  <div v-if=\"section === 'suppliers'\" class=\"py-12 text-center text-muted\">\n    {{ t('catalogue.comingSoon') }}\n  </div>\n\n  <div v-else class=\"space-y-6\">\n    <div class=\"flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between\">\n      <div>\n        <h1 class=\"text-2xl font-semibold text-highlighted\">\n          {{ section === 'stock' ? t('inventory.stock') : t('nav.warehouses') }}\n        </h1>\n        <p class=\"mt-1 text-sm text-muted\">\n          {{\n            section === 'stock'\n              ? t('inventory.stockDescription')\n              : t('inventory.warehousesDescription')\n          }}\n        </p>\n      </div>\n      <UButton\n        v-if=\"section === 'warehouses'\"\n        :label=\"t('inventory.addWarehouse')\"\n        @click=\"openWarehouse()\"\n      />\n    </div>\n    <UInput\n      v-model=\"search\"\n      icon=\"i-lucide-search\"\n      :placeholder=\"\n        section === 'stock' ? t('inventory.searchStock') : t('inventory.searchWarehouses')\n      \"\n      class=\"max-w-xl\"\n    />\n    <UTable\n      v-if=\"section === 'stock'\"\n      :data=\"paginatedStockItems\"\n      :columns=\"stockColumns\"\n      :loading=\"stockStatus === 'pending'\"\n      :ui=\"{\n        thead: '[&>tr]:bg-elevated/50 [&>tr]:after:content-none',\n        th: 'py-2 first:rounded-l-lg last:rounded-r-lg border-y border-default first:border-l last:border-r',\n        td: 'border-b border-default'\n      }\"\n    />\n    <UTable\n      v-else\n      :data=\"paginatedWarehouses\"\n      :columns=\"warehouseColumns\"\n      :loading=\"warehousesStatus === 'pending'\"\n      :ui=\"{\n        thead: '[&>tr]:bg-elevated/50 [&>tr]:after:content-none',\n        th: 'py-2 first:rounded-l-lg last:rounded-r-lg border-y border-default first:border-l last:border-r',\n        td: 'border-b border-default'\n      }\"\n    />\n    <TablePaginationFooter\n      v-if=\"section === 'stock'\"\n      v-model:page=\"stockPage\"\n      v-model:page-size=\"stockPagination.pageSize\"\n      :total=\"stockTotal\"\n    />\n    <TablePaginationFooter\n      v-else\n      v-model:page=\"warehousesPage\"\n      v-model:page-size=\"warehousesPagination.pageSize\"\n      :total=\"warehousesTotal\"\n    />\n  </div>\n\n  <UModal\n    v-model:open=\"warehouseOpen\"\n    :title=\"editingWarehouse ? t('common.edit') : t('inventory.addWarehouse')\"\n  >\n    <template #body>\n      <UForm class=\"space-y-5\" @submit.prevent=\"saveWarehouse\">\n        <UFormField\n          :label=\"t('inventory.warehouse')\"\n          :error=\"warehouseValidationErrors.name\"\n          required\n        >\n          <UInput\n            v-model=\"warehouseForm.name\"\n            class=\"w-full\"\n            @update:model-value=\"warehouseValidation.clear('name')\"\n          />\n        </UFormField>\n        <UFormField :label=\"t('inventory.code')\" :error=\"warehouseValidationErrors.code\" required>\n          <UInput\n            v-model=\"warehouseForm.code\"\n            :disabled=\"editingWarehouse?.default\"\n            class=\"w-full\"\n            @update:model-value=\"warehouseValidation.clear('code')\"\n          />\n        </UFormField>\n        <UFormField\n          :label=\"t('inventory.active')\"\n          class=\"flex items-center justify-between rounded-md border border-default px-3 py-2\"\n        >\n          <USwitch v-model=\"warehouseForm.active\" :disabled=\"editingWarehouse?.default\" />\n        </UFormField>\n        <div class=\"flex justify-end gap-2\">\n          <UButton\n            :label=\"t('common.cancel')\"\n            color=\"neutral\"\n            variant=\"subtle\"\n            @click=\"warehouseOpen = false\"\n          />\n          <UButton :label=\"t('common.save')\" type=\"submit\" :loading=\"saving\" />\n        </div>\n      </UForm>\n    </template>\n  </UModal>\n</template>\n"],"version":3}