A;AAAA,oBAFA,OAAOP,MAAA,CAAA,EAAC,qBAAA;AAAA,oBAA0B,OAAOA,MAAA,gBAAA,EAAiB;AAAA,oBAAM,UAAA;AAAA,kBAAA,GAAA;AAAA,qCAC3E,MAA4F;AAAA,sBAA5FO,YAA4F,mBAAA;AAAA,wBAA3E,YAAAP,MAAA,IAAA,EAAK;AAAA,wBAAL,uBAAA,CAAA,CAAA,WAAAA,MAAA,IAAA,EAAK,OAAI,QAAA,CAAA,WAAsCA,MAAA,UAAA,EAAW,MAAK,MAAA,CAAA;AAAA,wBAApD,OAAM;AAAA,sBAAA,GAAA,MAAA,GAAA,CAAA,cAAA,qBAAA,CAAA;AAAA;;;kBAEpCO,YAOa,uBAAA;AAAA,oBAPA,OAAOP,MAAA,CAAA,EAAC,qBAAA;AAAA,oBAA0B,OAAOA,MAAA,gBAAA,EAAiB;AAAA,oBAAM,UAAA;AAAA,kBAAA,GAAA;AAAA,qCAC3E,MAKE;AAAA,sBALFO,YAKE,mBAAA;AAAA,wBAJS,YAAAP,MAAA,IAAA,EAAK;AAAA,wBAAL,uBAAA,CAAA,CAAA,WAAAA,MAAA,IAAA,EAAK,OAAI,QAAA,CAAA,WAGGA,MAAA,UAAA,EAAW,MAAK,MAAA,CAAA;AAAA,wBAFrC,WAAU;AAAA,wBACV,OAAM;AAAA,sBAAA,GAAA,MAAA,GAAA,CAAA,cAAA,qBAAA,CAAA;AAAA;;;kBAIVO,YAQM,OAAA,EARD,OAAM,yBAAA,GAAwB;AAAA,oBACjCA,YAKEP,MAAA,OAAA,GAAA;AAAA,sBAJC,OAAOA,MAAA,CAAA,EAAC,eAAA;AAAA,sBACT,OAAM;AAAA,sBACN,SAAQ;AAAA,sBACP,SAAA,CAAA,WAAO,KAAA,QAAI;AAAA,oBAAA,GAAA,MAAA,GAAA,CAAA,SAAA,SAAA,CAAA;AAAA,oBAEdO,YAAqEP,MAAA,OAAA,GAAA;AAAA,sBAA3D,OAAOA,MAAA,CAAA,EAAC,aAAA;AAAA,sBAAiB,MAAK;AAAA,sBAAU,SAASA,MAAA,MAAA;AAAA,oBAAA,GAAA,MAAA,GAAA,CAAA,SAAA,SAAA,CAAA;AAAA;;;;;;;;;;QAMzD,MAAMA,MAAA,UAAA;AAAA,QAAA,iBAAA,CAAA,WAAAC,MAAA,UAAA,IAAA,WAAU,QAAA,SAAA;AAAA,QACvB,OAAOD,MAAA,CAAA,EAAC,eAAA;AAAA,QACR,aAAaA,MAAA,QAAA,GAAU;AAAA,QACvB,iBAAeA,MAAA,CAAA,EAAC,eAAA;AAAA,QAChB,WAAS;AAAA,MAAA,GAAA,MAAA,OAAA,CAAA;;;;;;;;;;;","names":["_withAsyncContext","__nuxt_component_0","__nuxt_component_1","_ssrInterpolate","_unref","_isRef","_withCtx","_push","_parent","_","_scopeId","_createVNode","_withModifiers"],"sources":["../../../../../../../app/pages/settings/shop/taxes.vue"],"sourcesContent":["<script setup lang=\"ts\">\nimport type { TableColumn } from '@nuxt/ui'\n\ntype Tax = {\n  id: string\n  name: string\n  rate: string\n  labels: Record<string, string>\n}\n\nconst { t } = useI18n()\nconst auth = useAuth()\nconst toast = useAppToast()\nconst open = ref(false)\nconst saving = ref(false)\nconst selectedLocale = ref('en-GB')\nconst editing = ref<Tax | null>(null)\nconst deleting = ref<Tax | null>(null)\nconst validation = useFormValidation()\nconst validationErrors = validation.errors\nconst deleteOpen = computed({\n  get: () => deleting.value !== null,\n  set: (value: boolean) => {\n    if (!value) deleting.value = null\n  }\n})\nconst form = reactive({ name: '', rate: '' })\nconst { data, refresh } = await useAsyncData('shop-taxes', () =>\n  apiFetch<{ taxes: Tax[] }>('/catalogue/references')\n)\nconst taxes = computed(() => data.value?.taxes ?? [])\nconst {\n  page: currentPage,\n  paginatedItems: paginatedTaxes,\n  pagination,\n  reset: resetPagination\n} = useClientPagination(() => taxes.value)\nconst { data: localesData } = await useAsyncData('shop-taxes-locales', () =>\n  apiFetch<{ locales: { code: string, label: string }[] }>('/property-groups/locales')\n)\nconst locales = computed(() => localesData.value?.locales ?? [])\nconst defaultLocale = computed(() => auth.tenant.value?.defaultSnippetLocale || 'en-GB')\nwatch(\n  () => pagination.value.pageSize,\n  resetPagination\n)\nwatch(defaultLocale, (locale) => {\n  if (!editing.value) selectedLocale.value = locale\n}, { immediate: true })\nconst UButton = resolveComponent('UButton')\nconst UDropdownMenu = resolveComponent('UDropdownMenu')\nconst columns: TableColumn<Tax>[] = [\n  {\n    id: 'label',\n    header: () => t('shopReferences.name'),\n    cell: ({ row }) =>\n      row.original.labels[selectedLocale.value]\n      || row.original.labels[defaultLocale.value]\n      || row.original.name\n  },\n  {\n    accessorKey: 'rate',\n    header: () => t('shopReferences.rate')\n  },\n  {\n    id: 'actions',\n    header: '',\n    cell: ({ row }) =>\n      h(\n        'div',\n        { class: 'flex justify-end' },\n        h(\n          UDropdownMenu,\n          {\n            content: { align: 'end' },\n            items: [\n              [\n                {\n                  label: t('common.edit'),\n                  icon: 'i-lucide-pencil',\n                  onSelect: () => edit(row.original)\n                }\n              ],\n              [\n                {\n                  label: t('common.delete'),\n                  icon: 'i-lucide-trash-2',\n                  color: 'error',\n                  onSelect: () => (deleting.value = row.original)\n                }\n              ]\n            ]\n          },\n          () =>\n            h(UButton, {\n              'icon': 'i-lucide-ellipsis-vertical',\n              'color': 'neutral',\n              'variant': 'ghost',\n              'aria-label': t('common.edit')\n            })\n        )\n      )\n  }\n]\nconst reset = () => {\n  editing.value = null\n  form.name = ''\n  form.rate = ''\n  validation.clear()\n}\nconst openCreate = () => {\n  reset()\n  selectedLocale.value = defaultLocale.value\n  open.value = true\n}\nconst edit = (tax: Tax) => {\n  editing.value = tax\n  form.name = tax.name\n  form.name = tax.labels[selectedLocale.value] || tax.labels[defaultLocale.value] || tax.name\n  form.rate = tax.rate\n  open.value = true\n}\nconst create = async () => {\n  if (\n    !validation.requireFields(\n      [\n        { field: 'name', value: form.name, label: t('shopReferences.name'), message: t('common.requiredField') },\n        { field: 'rate', value: form.rate, label: t('shopReferences.rate'), message: t('common.requiredField') }\n      ],\n      toast,\n      t('common.error'),\n      fields => t('common.requiredFields', { fields: fields.join(', ') })\n    )\n  ) {\n    return\n  }\n\n  saving.value = true\n  try {\n    await apiFetch(\n      editing.value\n        ? `/catalogue/references/taxes/${editing.value.id}`\n        : '/catalogue/references/taxes',\n      {\n        method: editing.value ? 'PATCH' : 'POST',\n        body: {\n          ...form,\n          labels: { [selectedLocale.value]: form.name }\n        }\n      }\n    )\n    await refresh()\n    open.value = false\n    reset()\n    toast.success(t('common.saved'), t('common.changesSaved'))\n  } catch (error: any) {\n    validation.notifyApiError(error, toast, t('common.error'), t('common.tryAgain'))\n  } finally {\n    saving.value = false\n  }\n}\nconst remove = async () => {\n  if (!deleting.value) return\n  try {\n    await apiFetch(`/catalogue/references/taxes/${deleting.value.id}`, { method: 'DELETE' })\n    deleting.value = null\n    await refresh()\n    toast.success(t('common.deleted'), t('common.changesSaved'))\n  } catch (error: any) {\n    toast.error(t('common.error'), error?.data?.message || t('common.tryAgain'))\n  }\n}\n</script>\n\n<template>\n  <div class=\"space-y-6\">\n    <div class=\"flex items-start justify-between gap-4\">\n      <div>\n        <h1 class=\"text-2xl font-semibold text-highlighted\">\n          {{ t('nav.taxes') }}\n        </h1>\n      </div>\n      <div class=\"flex items-center gap-2\">\n        <LocaleSelect\n          v-model=\"selectedLocale\"\n          :options=\"locales\"\n          class=\"w-56\"\n        />\n        <UButton\n          :label=\"t('common.add')\"\n          @click=\"openCreate\"\n        />\n      </div>\n    </div>\n\n    <UTable\n      :data=\"paginatedTaxes\"\n      :columns=\"columns\"\n      :ui=\"{\n        thead: '[&>tr]:bg-elevated/50 [&>tr]:after:content-none',\n        th: 'py-2 first:rounded-l-lg last:rounded-r-lg border-y border-default first:border-l last:border-r',\n        td: 'border-b border-default'\n      }\"\n    />\n    <TablePaginationFooter\n      v-model:page=\"currentPage\"\n      v-model:page-size=\"pagination.pageSize\"\n      :total=\"taxes.length\"\n    />\n  </div>\n\n  <UModal v-model:open=\"open\" :title=\"editing ? t('common.edit') : t('common.add')\">\n    <template #body>\n      <UForm class=\"space-y-4\" @submit.prevent=\"create\">\n        <ModalLocaleField\n          v-model=\"selectedLocale\"\n          :options=\"locales\"\n          :default-locale=\"defaultLocale\"\n          :active=\"open\"\n          :creating=\"!editing\"\n        />\n        <UFormField :label=\"t('shopReferences.name')\" :error=\"validationErrors.name\" required>\n          <UInput v-model=\"form.name\" class=\"w-full\" @update:model-value=\"validation.clear('name')\" />\n        </UFormField>\n        <UFormField :label=\"t('shopReferences.rate')\" :error=\"validationErrors.rate\" required>\n          <UInput\n            v-model=\"form.rate\"\n            inputmode=\"decimal\"\n            class=\"w-full\"\n            @update:model-value=\"validation.clear('rate')\"\n          />\n        </UFormField>\n        <div class=\"flex justify-end gap-2\">\n          <UButton\n            :label=\"t('common.cancel')\"\n            color=\"neutral\"\n            variant=\"subtle\"\n            @click=\"open = false\"\n          />\n          <UButton :label=\"t('common.save')\" type=\"submit\" :loading=\"saving\" />\n        </div>\n      </UForm>\n    </template>\n  </UModal>\n  <ConfirmationModal\n    v-model:open=\"deleteOpen\"\n    :title=\"t('common.delete')\"\n    :description=\"deleting?.name\"\n    :confirm-label=\"t('common.delete')\"\n    @confirm=\"remove\"\n  />\n</template>\n"],"version":3}