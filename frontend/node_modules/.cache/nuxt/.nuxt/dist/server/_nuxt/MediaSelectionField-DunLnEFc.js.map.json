AAK;AAAA,kBAChBA,YAA2D,KAAA,EAAxD,OAAM,0CAAuC,SAAO;AAAA,kBAC5CL,MAAA,aAAA,EAAa,CAAA,KAAAM,UAAA,GAAxBC,YASM,OAAA;AAAA,oBAAA,KAAA;AAAA,oBATuB,OAAM;AAAA,kBAAA,GAAA;AAAA,oBACjCF,YAIE,OAAA;AAAA,sBAHC,KAAKL,MAAA,aAAA,EAAa,CAAA,EAAI;AAAA,sBACtB,KAAKA,MAAA,aAAA,EAAa,CAAA,EAAI;AAAA,sBACvB,OAAM;AAAA,oBAAA,GAAA,MAAA,GAAA,CAAA,OAAA,KAAA,CAAA;AAAA,oBAERK,YAEI,KAAA,EAFD,OAAM,mCAAA,GAAkCK,gBACtCV,MAAA,aAAA,EAAA,CAAA,EAAiB,IAAI,GAAA,CAAA;AAAA,kBAAA,CAAA,MAAAM,UAAA,GAG5BC,YAA4E,KAAA;AAAA,oBAAA,KAAA;AAAA,oBAAlE,OAAM;AAAA,kBAAA,GAA0B,gCAA8B;AAAA,gBAAA,CAAA;AAAA;;;;QAInE,QAAAV,QAAX,CAQW,GAAAC,QAAAC,UAAA,aAAA;;;;cANE,OAAM;AAAA,cAAS,OAAM;AAAA,cAAU,SAAQ;AAAA,cAAU,SAAA,CAAA,WAAO,KAAA,QAAI;AAAA,YAAA,GAAA,MAAA,UAAA,QAAA,CAAA;;cAClE,OAAO,QAAA,WAAQ,OAAUC,MAAA,WAAA,EAAY,MAAM,WAAA;AAAA,cAC3C,UAAQ,CAAGA,MAAA,WAAA,EAAY;AAAA,cACvB,SAAO;AAAA,YAAA,GAAA,MAAA,UAAA,QAAA,CAAA;;;;cAJZK,YAMM,OAAA,EAND,OAAM,yBAAA,GAAwB;AAAA,gBACjCA,YAAiF,oBAAA;AAAA,kBAAxE,OAAM;AAAA,kBAAS,OAAM;AAAA,kBAAU,SAAQ;AAAA,kBAAU,SAAA,CAAA,WAAO,KAAA,QAAI;AAAA,gBAAA,GAAA,MAAA,GAAA,CAAA,SAAA,CAAA;AAAA,gBAAYA,YAI/E,oBAAA;AAAA,kBAHC,OAAO,QAAA,WAAQ,OAAUL,MAAA,WAAA,EAAY,MAAM,WAAA;AAAA,kBAC3C,UAAQ,CAAGA,MAAA,WAAA,EAAY;AAAA,kBACvB,SAAO;AAAA,gBAAA,GAAA,MAAA,GAAA,CAAA,SAAA,UAAA,CAAA;AAAA;;;;;;;;;;;;;;;;;;;;;;;;;;ACtIlB,UAAM,UAAUL,SAAmB,SAAA,YAAgB;AACnD,UAAM,aAAa,IAAI,KAAK;AAC5B,UAAM,QAAQ,IAA6B,IAAI;AAC/C,UAAM,YAAY,IAAI,KAAK;AACb,aAAA;AACd,UAAM,EAAE,MAAM,aAAY,CAAA,QAAA,SAAA,IAAAC,iBAAA,MAAM;AAAA,MAAa;AAAA,MAAyB,MACpE,SAAiC,QAAQ;AAAA,IAAA,CAC3C,GAAA,SAAA,MAAA,QAAA,UAAA,GAAA;AACA,UAAM,WAAW,SAAS,OAAO,KAAK,OAAO,SAAS,CAAA,GAAI,KAAK,CAAC,SAAS,KAAK,OAAO,QAAQ,KAAK,CAAC;;;;;;AA6BpF,UAAAI,MAAA,QAAA,GAAQ;wFAEd,OAAKA,MAAA,QAAA,EAAS,GAAG,kBACjB,OAAKA,MAAA,QAAA,EAAS,IAAI,CAAA,6DAAA;;UAInB,MAAK;AAAA,UACL,OAAM;AAAA,UACN,SAAQ;AAAA,UACR,MAAK;AAAA,UACL,cAAW;AAAA,UACV,SAAA,CAAA,WAAO,QAAA,QAAO;AAAA,QAAA,GAAA,MAAA,OAAA,CAAA;;;;;UAIV,MAAK;AAAA,UAAiB,OAAM;AAAA,QAAA,GAAA,MAAA,OAAA,CAAA;;;UAI/B,OAAM;AAAA,UACN,OAAM;AAAA,UACN,SAAQ;AAAA,UACR,MAAK;AAAA,UACJ,SAASA,MAAA,SAAA;AAAA,UACT,SAAK,CAAA,WAAEA,MAAA,KAAA,GAAO,MAAA;AAAA,QAAK,GAAA,MAAA,OAAA,CAAA;;UAGpB,MAAK;AAAA,UACL,MAAK;AAAA,UACL,cAAW;AAAA,UACV,SAAA,CAAA,WAAO,WAAA,QAAU;AAAA,QAAA,GAAA,MAAA,OAAA,CAAA;;;;;QAKA,MAAMA,MAAA,UAAA;AAAA,QAAA,iBAAA,CAAA,WAAAC,MAAA,UAAA,IAAA,WAAU,QAAA,SAAA;AAAA,QAAG,UAAA,CAAS,SAAU,QAAA,QAAU,KAAK;AAAA,MAAA,GAAA,MAAA,OAAA,CAAA;;;;;;;;;;;;","names":["_useModel","_withAsyncContext","_withCtx","_push","_parent","_unref","_isRef","_ssrRenderList","_ssrRenderAttr","_ssrInterpolate","_createVNode","_openBlock","_createBlock","_Fragment","_renderList","_toDisplayString"],"sources":["../../../../../../../app/components/MediaPickerModal.vue","../../../../../../../app/components/MediaSelectionField.vue"],"sourcesContent":["<script setup lang=\"ts\">\ntype MediaItem = { id: string; name: string; url: string }\n\nconst open = defineModel<boolean>('open', { default: false })\nconst props = withDefaults(defineProps<{ multiple?: boolean }>(), {\n  multiple: false,\n})\nconst emit = defineEmits<{\n  select: [media: MediaItem]\n  selectMany: [media: MediaItem[]]\n}>()\nconst search = ref('')\nconst selectedIds = ref<string[]>([])\nconst input = ref<HTMLInputElement | null>(null)\nconst uploading = ref(false)\nconst toast = useToast()\nconst { data, refresh } = await useAsyncData('media-library-picker', () =>\n  apiFetch<{ media: MediaItem[] }>('/media'),\n)\nconst media = computed(() => data.value?.media ?? [])\nconst filteredMedia = computed(() =>\n  media.value.filter((item) => item.name.toLowerCase().includes(search.value.toLowerCase())),\n)\n\nconst choose = (item: MediaItem) => {\n  selectedIds.value = props.multiple\n    ? selectedIds.value.includes(item.id)\n      ? selectedIds.value.filter((id) => id !== item.id)\n      : [...selectedIds.value, item.id]\n    : [item.id]\n}\nconst selectedMedia = computed(() =>\n  media.value.filter((item) => selectedIds.value.includes(item.id)),\n)\nconst applySelection = () => {\n  if (props.multiple) emit('selectMany', selectedMedia.value)\n  else if (selectedMedia.value[0]) emit('select', selectedMedia.value[0])\n  selectedIds.value = []\n  open.value = false\n}\nconst upload = async (event: Event) => {\n  const file = (event.target as HTMLInputElement).files?.[0]\n  if (!file) return\n  uploading.value = true\n  try {\n    const body = new FormData()\n    body.append('file', file)\n    const response = await apiFetch<{ media: MediaItem }>('/media', {\n      method: 'POST',\n      body,\n    })\n    await refresh()\n    choose(response.media)\n  } catch (error: any) {\n    toast.add({\n      title: error?.data?.message || 'Image could not be uploaded.',\n      color: 'error',\n    })\n  } finally {\n    uploading.value = false\n    ;(event.target as HTMLInputElement).value = ''\n  }\n}\n</script>\n\n<template>\n  <UModal v-model:open=\"open\" title=\"Choose media\" :ui=\"{ content: 'max-w-6xl' }\">\n    <template #body>\n      <div class=\"grid min-h-130 grid-cols-[minmax(0,1fr)_300px]\">\n        <div class=\"space-y-5 border-r border-default p-5\">\n          <div class=\"flex gap-3\">\n            <UInput\n              v-model=\"search\"\n              icon=\"i-lucide-search\"\n              placeholder=\"Search images…\"\n              class=\"flex-1\"\n            /><input\n              ref=\"input\"\n              type=\"file\"\n              accept=\"image/*\"\n              class=\"hidden\"\n              @change=\"upload\"\n            /><UButton label=\"Upload image\" :loading=\"uploading\" @click=\"input?.click()\" />\n          </div>\n          <div\n            v-if=\"!filteredMedia.length\"\n            class=\"rounded-xl border border-dashed border-default px-6 py-20 text-center\"\n          >\n            <UIcon name=\"i-lucide-images\" class=\"mx-auto size-10 text-muted\" />\n            <p class=\"mt-3 font-medium text-highlighted\">No images found</p>\n          </div>\n          <div\n            v-else\n            class=\"grid max-h-110 grid-cols-3 gap-3 overflow-y-auto pr-1 sm:grid-cols-4 lg:grid-cols-5\"\n          >\n            <button\n              v-for=\"item in filteredMedia\"\n              :key=\"item.id\"\n              type=\"button\"\n              class=\"overflow-hidden rounded-lg border bg-default text-left\"\n              :class=\"\n                selectedIds.includes(item.id)\n                  ? 'border-primary ring-2 ring-primary/25'\n                  : 'border-default'\n              \"\n              @click=\"choose(item)\"\n            >\n              <img\n                :src=\"item.url\"\n                :alt=\"item.name\"\n                class=\"aspect-square w-full object-cover\"\n              /><span class=\"block truncate p-2 text-xs\">{{ item.name }}</span>\n            </button>\n          </div>\n        </div>\n        <aside class=\"p-5\">\n          <p class=\"text-sm font-medium text-highlighted\">Preview</p>\n          <div v-if=\"selectedMedia[0]\" class=\"mt-4\">\n            <img\n              :src=\"selectedMedia[0].url\"\n              :alt=\"selectedMedia[0].name\"\n              class=\"aspect-square w-full rounded-lg border border-default object-cover\"\n            />\n            <p class=\"mt-3 truncate text-sm text-muted\">\n              {{ selectedMedia[0].name }}\n            </p>\n          </div>\n          <p v-else class=\"mt-4 text-sm text-muted\">Select an image to preview it.</p>\n        </aside>\n      </div>\n    </template>\n    <template #footer>\n      <div class=\"flex justify-end gap-2\">\n        <UButton label=\"Cancel\" color=\"neutral\" variant=\"subtle\" @click=\"open = false\" /><UButton\n          :label=\"multiple ? `Add ${selectedIds.length} media` : 'Add media'\"\n          :disabled=\"!selectedIds.length\"\n          @click=\"applySelection\"\n        />\n      </div>\n    </template>\n  </UModal>\n</template>\n","<script setup lang=\"ts\">\ntype MediaItem = { id: string; name: string; url: string }\nconst mediaId = defineModel<string>({ default: '' })\nconst pickerOpen = ref(false)\nconst input = ref<HTMLInputElement | null>(null)\nconst uploading = ref(false)\nconst toast = useToast()\nconst { data, refresh } = await useAsyncData('media-selection-field', () =>\n  apiFetch<{ media: MediaItem[] }>('/media'),\n)\nconst selected = computed(() => (data.value?.media ?? []).find((item) => item.id === mediaId.value))\nconst upload = async (event: Event) => {\n  const file = (event.target as HTMLInputElement).files?.[0]\n  if (!file) return\n  uploading.value = true\n  try {\n    const body = new FormData()\n    body.append('file', file)\n    const response = await apiFetch<{ media: MediaItem }>('/media', {\n      method: 'POST',\n      body,\n    })\n    await refresh()\n    mediaId.value = response.media.id\n  } catch (error: any) {\n    toast.add({\n      title: error?.data?.message || 'Image could not be uploaded.',\n      color: 'error',\n    })\n  } finally {\n    uploading.value = false\n    const target = event.target as HTMLInputElement\n    target.value = ''\n  }\n}\n</script>\n\n<template>\n  <div class=\"rounded-md border border-dashed border-muted bg-elevated/20 p-2\">\n    <div v-if=\"selected\" class=\"flex items-center justify-between gap-3\">\n      <img\n        :src=\"selected.url\"\n        :alt=\"selected.name\"\n        class=\"size-9 rounded border border-default object-cover\"\n      />\n      <UButton\n        icon=\"i-lucide-x\"\n        color=\"neutral\"\n        variant=\"ghost\"\n        size=\"xs\"\n        aria-label=\"Remove image\"\n        @click=\"mediaId = ''\"\n      />\n    </div>\n    <div v-else class=\"flex items-center justify-between gap-3\">\n      <UIcon name=\"i-lucide-image\" class=\"size-8 text-muted\" />\n      <div class=\"ml-auto flex gap-2\">\n        <input ref=\"input\" type=\"file\" accept=\"image/*\" class=\"hidden\" @change=\"upload\" />\n        <UButton\n          label=\"Upload file\"\n          color=\"neutral\"\n          variant=\"outline\"\n          size=\"sm\"\n          :loading=\"uploading\"\n          @click=\"input?.click()\"\n        />\n        <UButton\n          icon=\"i-lucide-image-plus\"\n          size=\"sm\"\n          aria-label=\"Select image\"\n          @click=\"pickerOpen = true\"\n        />\n      </div>\n    </div>\n  </div>\n  <MediaPickerModal v-model:open=\"pickerOpen\" @select=\"(item) => (mediaId = item.id)\" />\n</template>\n"],"version":3}