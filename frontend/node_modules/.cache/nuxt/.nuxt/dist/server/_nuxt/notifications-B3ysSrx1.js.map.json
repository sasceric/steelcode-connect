_createVNode","_openBlock","_createBlock","_Fragment","_renderList"],"sources":["../../../../../../../app/pages/settings/notifications.vue"],"sourcesContent":["<script setup lang=\"ts\">\nconst state = reactive<{ [key: string]: boolean }>({\n  email: true,\n  desktop: false,\n  product_updates: true,\n  weekly_digest: false,\n  important_updates: true,\n})\n\nconst sections = [\n  {\n    title: 'Notification channels',\n    description: 'Where can we notify you?',\n    fields: [\n      {\n        name: 'email',\n        label: 'Email',\n        description: 'Receive a daily email digest.',\n      },\n      {\n        name: 'desktop',\n        label: 'Desktop',\n        description: 'Receive desktop notifications.',\n      },\n    ],\n  },\n  {\n    title: 'Account updates',\n    description: 'Receive updates about Nuxt UI.',\n    fields: [\n      {\n        name: 'weekly_digest',\n        label: 'Weekly digest',\n        description: 'Receive a weekly digest of news.',\n      },\n      {\n        name: 'product_updates',\n        label: 'Product updates',\n        description: 'Receive a monthly email with all new features and updates.',\n      },\n      {\n        name: 'important_updates',\n        label: 'Important updates',\n        description:\n          'Receive emails about important updates like security fixes, maintenance, etc.',\n      },\n    ],\n  },\n]\n\nasync function onChange() {\n  // Do something with data\n  console.log(state)\n}\n</script>\n\n<template>\n  <div v-for=\"(section, index) in sections\" :key=\"index\">\n    <UPageCard\n      :title=\"section.title\"\n      :description=\"section.description\"\n      variant=\"naked\"\n      class=\"mb-4\"\n    />\n\n    <UPageCard variant=\"subtle\" :ui=\"{ container: 'divide-y divide-default' }\">\n      <UFormField\n        v-for=\"field in section.fields\"\n        :key=\"field.name\"\n        :name=\"field.name\"\n        :label=\"field.label\"\n        :description=\"field.description\"\n      