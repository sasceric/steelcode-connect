B,UAAA;AAAA,sBAAA,GAAA;AAAA,yCAC3C,MAAwE;AAAA,0BAAxEG,YAAwE,mBAAA;AAAA,4BAAvD,YAAAH,MAAA,YAAA,EAAa;AAAA,4BAAb,uBAAA,CAAA,WAAAA,MAAA,YAAA,EAAa,MAAG;AAAA,4BAAE,WAAU;AAAA,4BAAU,OAAM;AAAA,0BAAA,GAAA,MAAA,GAAA,CAAA,cAAA,qBAAA,CAAA;AAAA;;;sBAE/DG,YAEa,uBAAA;AAAA,wBAFA,OAAOH,MAAA,CAAA,EAAC,qBAAA;AAAA,wBAAyB,UAAA;AAAA,sBAAA,GAAA;AAAA,yCAC5C,MAA2G;AAAA,0BAA3GG,YAA2G,oBAAA;AAAA,4BAAzF,YAAAH,MAAA,YAAA,EAAa;AAAA,4BAAb,uBAAA,CAAA,WAAAA,MAAA,YAAA,EAAa,OAAI;AAAA,4BAAG,OAAO,CAAA,UAAA,UAAA,QAAA,OAAA,MAAA;AAAA,4BAA6C,OAAM;AAAA,0BAAA,GAAA,MAAA,GAAA,CAAA,cAAA,qBAAA,CAAA;AAAA;;;;;kBAItGG,YAGM,OAAA,EAHD,OAAM,yBAAA,GAAwB;AAAA,oBACjCA,YAA8F,oBAAA;AAAA,sBAApF,OAAOH,MAAA,CAAA,EAAC,eAAA;AAAA,sBAAmB,OAAM;AAAA,sBAAU,SAAQ;AAAA,sBAAU,SAAA,CAAA,WAAO,KAAA,QAAI;AAAA,oBAAA,GAAA,MAAA,GAAA,CAAA,SAAA,SAAA,CAAA;AAAA,oBAClFG,YAAqE,oBAAA;AAAA,sBAA3D,OAAOH,MAAA,CAAA,EAAC,aAAA;AAAA,sBAAiB,MAAK;AAAA,sBAAU,SAASA,MAAA,MAAA;AAAA,oBAAA,GAAA,MAAA,GAAA,CAAA,SAAA,SAAA,CAAA;AAAA;;;;;;;;;;;;;;;;;;;","names":["_withAsyncContext","_withCtx","_push","_parent","_unref","_","_scopeId","_createVNode","_isRef","_openBlock","_createBlock","_Fragment","_withModifiers"],"sources":["../../../../../../../app/pages/settings/shop/references.vue"],"sourcesContent":["<script setup lang=\"ts\">\nconst { t } = useI18n()\nconst toast = useAppToast()\nconst route = useRoute()\nconst activeTab = ref(typeof route.query.tab === 'string' ? route.query.tab : 'taxes')\nconst open = ref(false)\nconst saving = ref(false)\nconst tax = reactive({ name: '', rate: '' })\nconst unit = reactive({ code: '', symbol: '', label: '' })\nconst deliveryTime = reactive({ label: '', min: '', max: '', unit: 'day' })\n\nconst { data, refresh } = await useAsyncData('catalogue-references-settings', () =>\n  apiFetch<{\n    taxes: { id: string; name: string; rate: string }[]\n    units: { id: string; code: string; symbol: string; labels: Record<string, string> }[]\n    deliveryTimes: {\n      id: string\n      labels: Record<string, string>\n      min: number\n      max: number\n      unit: string\n    }[]\n  }>('/catalogue/references'),\n)\n\nconst tabs = computed(() => [\n  { label: t('shopReferences.taxes'), value: 'taxes' },\n  { label: t('shopReferences.units'), value: 'units' },\n  { label: t('shopReferences.deliveryTimes'), value: 'delivery-times' },\n])\n\nconst create = async () => {\n  saving.value = true\n  try {\n    if (activeTab.value === 'taxes') {\n      await apiFetch('/catalogue/references/taxes', {\n        method: 'POST',\n        body: tax,\n      })\n    } else if (activeTab.value === 'units') {\n      await apiFetch('/catalogue/references/units', {\n        method: 'POST',\n        body: {\n          code: unit.code,\n          symbol: unit.symbol,\n          labels: { 'bs-BA': unit.label },\n        },\n      })\n    } else {\n      await apiFetch('/catalogue/references/delivery-times', {\n        method: 'POST',\n        body: {\n          labels: { 'bs-BA': deliveryTime.label },\n          min: Number(deliveryTime.min),\n          max: Number(deliveryTime.max),\n          unit: deliveryTime.unit,\n        },\n      })\n    }\n\n    await refresh()\n    open.value = false\n    toast.success(t('common.saved'), t('common.changesSaved'))\n  } catch (error: any) {\n    toast.error(t('common.error'), error?.data?.message || t('common.tryAgain'))\n  } finally {\n    saving.value = false\n  }\n}\n</script>\n\n<template>\n  <UDashboardPanel id=\"shop-references\" :ui=\"{ body: 'lg:py-12' }\">\n    <template #header>\n      <UDashboardNavbar :title=\"t('shopReferences.title')\">\n        <template #leading>\n          <UDashboardSidebarCollapse />\n        </template>\n        <template #right>\n          <UButton :label=\"t('common.add')\" @click=\"open = true\" />\n        </template>\n      </UDashboardNavbar>\n    </template>\n\n    <template #body>\n      <div class=\"mx-auto w-full max-w-7xl space-y-6\">\n        <UTabs v-model=\"activeTab\" :items=\"tabs\" :content=\"false\" />\n\n        <UPageCard v-if=\"activeTab === 'taxes'\">\n          <UTable :data=\"data?.taxes || []\" :columns=\"[\n            { accessorKey: 'name', header: t('shopReferences.name') },\n            { accessorKey: 'rate', header: t('shopReferences.rate') },\n          ]\" />\n        </UPageCard>\n        <UPageCard v-else-if=\"activeTab === 'units'\">\n          <UTable :data=\"data?.units || []\" :columns=\"[\n            { accessorKey: 'code', header: t('shopReferences.code') },\n            { accessorKey: 'symbol', header: t('shopReferences.symbol') },\n          ]\" />\n        </UPageCard>\n        <UPageCard v-else>\n          <UTable :data=\"data?.deliveryTimes || []\" :columns=\"[\n            { id: 'name', header: t('shopReferences.name'), cell: ({ row }) => row.original.labels['bs-BA'] || '—' },\n            { accessorKey: 'min', header: t('shopReferences.min') },\n            { accessorKey: 'max', header: t('shopReferences.max') },\n            { accessorKey: 'unit', header: t('shopReferences.unit') },\n          ]\" />\n        </UPageCard>\n      </div>\n    </template>\n  </UDashboardPanel>\n\n  <UModal v-model:open=\"open\" :title=\"t('common.add')\">\n    <template #body>\n      <UForm class=\"space-y-4\" @submit.prevent=\"create\">\n        <template v-if=\"activeTab === 'taxes'\">\n          <UFormField :label=\"t('shopReferences.name')\" required>\n            <UInput v-model=\"tax.name\" class=\"w-full\" />\n          </UFormField>\n          <UFormField :label=\"t('shopReferences.rate')\" required>\n            <UInput v-model=\"tax.rate\" inputmode=\"decimal\" class=\"w-full\" />\n          </UFormField>\n        </template>\n        <template v-else-if=\"activeTab === 'units'\">\n          <UFormField :label=\"t('shopReferences.code')\" required>\n            <UInput v-model=\"unit.code\" class=\"w-full\" />\n          </UFormField>\n          <UFormField :label=\"t('shopReferences.symbol')\" required>\n            <UInput v-model=\"unit.symbol\" class=\"w-full\" />\n          </UFormField>\n          <UFormField :label=\"t('shopReferences.name')\" required>\n            <UInput v-model=\"unit.label\" class=\"w-full\" />\n          </UFormField>\n        </template>\n        <template v-else>\n          <UFormField :label=\"t('shopReferences.name')\" required>\n            <UInput v-model=\"deliveryTime.label\" class=\"w-full\" />\n          </UFormField>\n          <div class=\"grid gap-4 sm:grid-cols-3\">\n            <UFormField :label=\"t('shopReferences.min')\" required>\n              <UInput v-model=\"deliveryTime.min\" inputmode=\"numeric\" class=\"w-full\" />\n            </UFormField>\n            <UFormField :label=\"t('shopReferences.max')\" required>\n              <UInput v-model=\"deliveryTime.max\" inputmode=\"numeric\" class=\"w-full\" />\n            </UFormField>\n            <UFormField :label=\"t('shopReferences.unit')\" required>\n              <USelect v-model=\"deliveryTime.unit\" :items=\"['second', 'minute', 'hour', 'day', 'week']\" class=\"w-full\" />\n            </UFormField>\n          </div>\n        </template>\n        <div class=\"flex justify-end gap-2\">\n          <UButton :label=\"t('common.cancel')\" color=\"neutral\" variant=\"subtle\" @click=\"open = false\" />\n          <UButton :label=\"t('common.save')\" type=\"submit\" :loading=\"saving\" />\n        </div>\n      </UForm>\n    </template>\n  </UModal>\n</template>\n"],"version":3}