,gBACC,SAAK,CAAA,WAAE,OAAO,IAAI;AAAA,cAAA,GAAA,MAAA,UAAA,QAAA,CAAA;;;;gBApCvBM,YAsCM,OAAA,EAtCD,OAAM,YAAA,GAAW;AAAA,kBACpBA,YAaM,OAAA,MAAA;AAAA,oBAZJA,YAEK,QAFD,OAAM,wBAAA,GAAuBC,gBAC5B,KAAK,IAAI,GAAA,CAAA;AAAA,oBAEdD,YAQI,KAAA,EARD,OAAM,qBAAA,GAAoBC,gBAEzB,KAAK,iBAAY,OAA8BP,MAAA,CAAA,EAAC,2BAAA,IAAkDA,MAAA,CAAA,EAAC,wBAAA;AAAA,sBAAA,OAAwD,KAAK,aAAa,eAAA;AAAA,oBAAc,CAAA,CAAA,GAAA,CAAA;AAAA;kBASxLA,MAAA,QAAA,MAAQ,YAAAQ,UAAA,GAAjBC,YAEI,KAAA;AAAA,oBAAA,KAAA;AAAA,oBAF4B,OAAM;AAAA,kBAAA,GAC/BF,iBAAA,KAAK,QAAK,KAAA,KAAc,QAAA,CAAA,CAAA,IAAa,QAC5C,CAAA,KAAAG,mBAAA,IAAA,IAAA;AAAA,kBACAJ,YAMI,KAAA,EAND,OAAM,yBAAA,GAAwB;AAAA,oBAC3BK,gBAAAJ,iBAAA,MAAM,IAAI,IAAA,KAAS,QAAA,CAAA,CAAA,IAAa,KACpC,CAAA;AAAA,oBAAAD,YAGO,QAAA,EAHD,OAAM,0BAAuB,WAEjCC,gBAAGP,MAAA,QAAA,MAAQ,WAAgBA,MAAA,CAAA,EAAC,cAAA,IAAmBA,MAAA,CAAA,EAAC,eAAA,CAAA,GAAA,CAAA;AAAA,kBAAA,CAAA;AAAA,kBAIpDM,YAUE,oBAAA;AAAA,oBATC,OAAsBN,MAAA,YAAA,GAAc,SAAS,KAAK,QAAQA,MAAA,YAAA,GAAc,aAAaA,MAAA,QAAA,IAA2BA,MAAA,CAAA,EAAC,qBAAA,IAA0CA,MAAA,CAAA,EAAC,oBAAA;AAAA,oBAK5J,UAAUA,MAAA,YAAA,GAAc,SAAS,KAAK,QAAQA,MAAA,YAAA,GAAc,aAAaA,MAAA,QAAA;AAAA,oBACzE,SAASA,MAAA,MAAA,MAAW,KAAK;AAAA,oBAC1B,OAAA;AAAA,oBACC,SAAK,CAAA,WAAE,OAAO,IAAI;AAAA,kBAAA,GAAA,MAAA,GAAA,CAAA,SAAA,YAAA,WAAA,SAAA,CAAA;AAAA;;;;;;;;;;;;;;;;;","names":["_unref","_isRef","_ssrRenderList","_push","_parent","_ssrInterpolate","_createVNode","_toDisplayString","_openBlock","_createBlock","_createCommentVNode","_createTextVNode"],"sources":["../../../../../../../app/pages/company/pricing-plans.vue"],"sourcesContent":["<script setup lang=\"ts\">\nconst company = useCompany()\nconst { plans, subscription } = company\nconst toast = useToast()\nconst { t } = useI18n()\nconst interval = ref<Subscription['interval']>('monthly')\nconst saving = ref<string>()\n\nconst price = (plan: SubscriptionPlan) => {\n  return interval.value === 'annual' ? plan.price * 12 * 0.9 : plan.price\n}\n\nconst select = async (plan: SubscriptionPlan) => {\n  saving.value = plan.code\n\n  try {\n    await company.selectPlan(plan.code, interval.value)\n    toast.add({ title: t('company.planUpdated'), color: 'success' })\n  } catch (error) {\n    toast.add({\n      title: error instanceof Error ? error.message : t('company.unableToSelectPlan'),\n      color: 'error',\n    })\n  } finally {\n    saving.value = undefined\n  }\n}\n\nonMounted(async () => {\n  await company.loadSubscription()\n  interval.value = company.subscription.value?.interval || 'monthly'\n})\n</script>\n\n<template>\n  <div>\n    <UPageCard\n      :title=\"t('company.pricingPlans')\"\n      :description=\"t('company.pricingDescription')\"\n      variant=\"naked\"\n      class=\"mb-4\"\n    />\n\n    <div class=\"mb-4 flex justify-center\">\n      <UTabs\n        v-model=\"interval\"\n        :items=\"[\n          { label: t('company.monthly'), value: 'monthly' },\n          { label: t('company.annual'), value: 'annual' },\n        ]\"\n        :content=\"false\"\n      />\n    </div>\n\n    <div class=\"grid gap-4 lg:grid-cols-3\">\n      <UCard\n        v-for=\"plan in plans\"\n        :key=\"plan.code\"\n        :class=\"{\n          'ring-2 ring-primary':\n            subscription?.code === plan.code && subscription?.interval === interval,\n        }\"\n      >\n        <div class=\"space-y-4\">\n          <div>\n            <h3 class=\"text-lg font-semibold\">\n              {{ plan.name }}\n            </h3>\n            <p class=\"text-sm text-muted\">\n              {{\n                plan.productLimit === null\n                  ? t('company.unlimitedProducts')\n                  : t('company.upToProducts', {\n                      count: plan.productLimit.toLocaleString(),\n                    })\n              }}\n            </p>\n          </div>\n\n          <p v-if=\"interval === 'annual'\" class=\"text-sm text-error line-through\">\n            {{ ((plan.price * 12) / 100).toFixed(2) }} KM\n          </p>\n          <p class=\"text-3xl font-semibold\">\n            {{ (price(plan) / 100).toFixed(2) }}\n            <span class=\"text-base text-muted\">\n              KM /\n              {{ interval === 'annual' ? t('company.year') : t('company.month') }}\n            </span>\n          </p>\n\n          <UButton\n            :label=\"\n              subscription?.code === plan.code && subscription?.interval === interval\n                ? t('company.currentPlan')\n                : t('company.selectPlan')\n            \"\n            :disabled=\"subscription?.code === plan.code && subscription?.interval === interval\"\n            :loading=\"saving === plan.code\"\n            block\n            @click=\"select(plan)\"\n          />\n        </div>\n      </UCard>\n    </div>\n  </div>\n</template>\n"],"version":3}